# Copiar a `.env`. Lo cargan prisma.config.ts (CLI de Prisma) y src/main.ts (app) vía dotenv.
PORT=3000
NODE_ENV=development

# Zona horaria del proceso. El día operativo se calcula siempre en America/Bogota
# (ver src/domain/shared/fecha-operativa.ts), pero fijarla evita sorpresas en logs.
TZ=America/Bogota

# Opcional: APM de NestJS (https://observe.nestjs.com). Si se dejan vacías,
# el módulo Observe no se registra.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=

# =============================================================
# PERSISTENCIA: "postgres" (por defecto) o "firestore".
# Las dos implementaciones conviven en el código; se elige al arrancar.
# =============================================================
PERSISTENCIA=postgres

# --- PostgreSQL (PERSISTENCIA=postgres) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mq_db?schema=public"

# --- Firebase / Firestore (PERSISTENCIA=firestore) ---
# Cuenta de servicio: Consola de Firebase → ⚙ Configuración del proyecto →
# Cuentas de servicio → "Generar nueva clave privada". Del JSON descargado:
#   project_id    → FIREBASE_PROJECT_ID
#   client_email  → FIREBASE_CLIENT_EMAIL
#   private_key   → FIREBASE_PRIVATE_KEY (pegar completa, entre comillas, con los \n tal cual)
# El JSON es una credencial de administrador: NUNCA subirlo a Git.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Solo desarrollo con emulador (firebase emulators:start); deja vacío en producción.
# FIRESTORE_EMULATOR_HOST=localhost:8080

# Autenticación (JWT). El secreto firma los tokens: si se filtra, cualquiera
# puede falsificar sesiones. Mínimo 32 caracteres; la app no arranca sin él.
# Generar uno: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=""
# Vigencia del token. 12h cubre el turno más largo (10h) con margen.
JWT_EXPIRES_IN=12h

# Administrador inicial. Lo crea `npx prisma db seed` solo si no existe
# ningún usuario con ese documento; las corridas siguientes no lo tocan.
ADMIN_INICIAL_DOCUMENTO=""
ADMIN_INICIAL_NOMBRE="Administrador"
ADMIN_INICIAL_PASSWORD=""

# PDF (Puppeteer). Ruta a un Chrome/Chromium ya instalado. Si se deja vacía,
# Puppeteer usa el Chrome que descarga en ~/.cache/puppeteer al hacer npm install
# (puede fallar si la ruta del perfil de usuario tiene acentos). En Docker
# apunta al chromium del sistema: /usr/bin/chromium.
# Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
PUPPETEER_EXECUTABLE_PATH=""
