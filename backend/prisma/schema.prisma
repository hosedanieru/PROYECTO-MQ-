// ============================================================
// APLICATIVO MAQUILA (MQ) — Inlotrans S.A.S.
// Fase 0: catálogos, usuarios, permisos, auditoría
// Fase 1: Remisiones
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

enum EstadoRemision {
  BORRADOR
  ENTREGADA
  APROBADA
  RECHAZADA
  EN_RECTIFICACION
  VALIDADA
}

/// Tipo de proceso del producto. Valores tomados de la hoja PRODUCTOS
/// del Excel actual. PENDIENTE: confirmar si existen otros valores.
enum ProcesoProducto {
  MANUAL
  AUTOMATICA
}

enum AccionAuditoria {
  CREAR
  ACTUALIZAR
  CAMBIO_ESTADO
  ELIMINAR
}

/// Tipo de máquina de la línea, como lo nombra el DPP de PepsiCo.
enum TipoLinea {
  MULTIPACK
  MANUAL
}

/// De dónde salió un bloque: digitado, importado del PDF del DPP o copiado de otro día.
enum OrigenBloque {
  MANUAL
  DPP
  COPIA
}

// ============================================================
// USUARIOS Y PERMISOS
// ============================================================

model Usuario {
  id           String  @id @default(uuid())
  documento    String  @unique
  nombre       String
  email        String? @unique
  passwordHash String  @map("password_hash")
  activo       Boolean @default(true)

  rolId String @map("rol_id")
  rol   Rol    @relation(fields: [rolId], references: [id])

  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  // Relaciones con Remisión (nombradas por ser múltiples hacia Usuario)
  remisionesCreadas    Remision[]        @relation("RemisionCreadaPor")
  remisionesEntregadas Remision[]        @relation("RemisionEntregadaPor")
  remisionesValidadas  Remision[]        @relation("RemisionValidadaPor")
  rectificaciones      RemisionVersion[]
  auditorias           Auditoria[]

  // MFR
  bloquesCreados  BloqueProgramacion[] @relation("BloqueCreadoPor")
  bloquesCerrados BloqueProgramacion[] @relation("BloqueCerradoPor")
  asistencias     AsistenciaTurno[]    @relation("AsistenciaRegistradaPor")
  asignaciones    AsignacionLinea[]    @relation("AsignacionRegistradaPor")

  // Averías
  averiasReportadas ReporteAveria[] @relation("AveriaReportadaPor")
  averiasAnuladas   ReporteAveria[] @relation("AveriaAnuladaPor")

  // Inventario
  movimientosInventario MovimientoInventario[]
  entradasMercancia     EntradaMercancia[]
  recetasCreadas        Receta[]
  cierresInventario     CierreInventario[]
  enviosCorreo          EnvioCorreo[]
  resumenesTurno        ResumenTurno[]
  firmasRemision        FirmaRemision[]
  ajustesEsperadas      AjusteEsperadas[]

  @@map("usuario")
}

model Rol {
  id          String  @id @default(uuid())
  codigo      String  @unique // COORDINADOR_MQ, PATINADOR, ADMINISTRADOR
  nombre      String
  descripcion String?
  activo      Boolean @default(true)

  usuarios Usuario[]
  permisos RolPermiso[]

  @@map("rol")
}

model Permiso {
  id          String  @id @default(uuid())
  codigo      String  @unique // remision.crear, remision.aprobar, catalogo.editar
  modulo      String // remision, catalogo, mfr, admin
  descripcion String?

  roles RolPermiso[]

  @@index([modulo])
  @@map("permiso")
}

model RolPermiso {
  rolId     String @map("rol_id")
  permisoId String @map("permiso_id")

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("rol_permiso")
}

// ============================================================
// CATÁLOGOS
// ============================================================

model Lugar {
  id     String  @id @default(uuid())
  codigo String  @unique
  nombre String // "MAQUILA PEPSICO SANTO DOMINGO"
  activo Boolean @default(true)

  remisiones Remision[]

  @@map("lugar")
}

/// Grupo (antes "proveedor", área 2026-09-21): quien pone el personal
/// del turno. Valores actuales: LOGICMARD, MAXISERVICE, APOYOS MAXI, MIX.
/// `descripcion` es texto libre donde se escribe el proveedor real;
/// `personas_esperadas` se compara con la asistencia del turno.
model Grupo {
  id                String  @id @default(uuid())
  codigo            String  @unique
  descripcion       String?
  nombre            String
  activo            Boolean @default(true)

  remisiones        Remision[]
  asistencias       AsistenciaTurno[]
  asignaciones      AsignacionLinea[]
  averias           ReporteAveria[]
  esperadasPorTurno GrupoEsperadasTurno[]
  ajustesEsperadas  AjusteEsperadas[]

  @@map("grupo")
}

/// Personas que un grupo debería enviar a cada turno (usuario, 2026-10-03;
/// antes era un solo número por grupo). Sin fila = no se espera en ese turno.
model GrupoEsperadasTurno {
  grupoId  String @map("grupo_id")
  grupo    Grupo  @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  turnoId  String @map("turno_id")
  turno    Turno  @relation(fields: [turnoId], references: [id])
  personas Int

  @@id([grupoId, turnoId])
  @@map("grupo_esperadas_turno")
}

/// Ajuste de un día puntual a las esperadas de un grupo en un turno, con
/// motivo (festivo, pedido especial). Manda sobre lo fijo del grupo.
model AjusteEsperadas {
  id             String   @id @default(uuid())
  fechaOperativa DateTime @map("fecha_operativa") @db.Date
  turnoId        String   @map("turno_id")
  turno          Turno    @relation(fields: [turnoId], references: [id])
  grupoId        String   @map("grupo_id")
  grupo          Grupo    @relation(fields: [grupoId], references: [id])
  /// 0 = ese día el grupo no se espera en el turno.
  personas       Int
  motivo         String
  usuarioId      String   @map("usuario_id")
  usuario        Usuario  @relation(fields: [usuarioId], references: [id])
  fechaRegistro  DateTime @map("fecha_registro") @db.Timestamptz(3)

  @@unique([fechaOperativa, turnoId, grupoId])
  @@index([fechaOperativa])
  @@map("ajuste_esperadas")
}

/// Catálogo de productos. Administrable desde el panel.
/// PENDIENTE: sincronización con SAP (ver plan-desarrollo-mq.md, pendiente 7).
/// El estándar por hora es atributo del SKU; las horas del turno NO
/// (ver decisión 2.2 del plan de desarrollo).
model Producto {
  id          String           @id @default(uuid())
  codigo      String           @unique // código de ítem, ej. 300058141
  descripcion String
  proceso     ProcesoProducto?

  unidadesPorCaja Int?    @map("unidades_por_caja")
  cajasPorEstiba  Int?    @map("cajas_por_estiba")
  /// LINEA IDEAL de la hoja TIEMPOS: personas necesarias en la línea para ese SKU.
  personasIdeal   Int?    @map("personas_ideal")
  /// SUBDESCRIPCION: familia (SURTIDO, OFERTA, REEMPAQUE, MULTIPACK…). Agrupa el "Flavor Breakdown".
  subdescripcion  String?

  // Estándar de producción, con los nombres del DPP de PepsiCo:
  //   cajasPorHora ritmo al 100 % (hoja TIEMPOS); por defecto para bloques a mano
  //   pesoNetoKg kilos netos de una caja (para Target/Instant Kilograms)
  cajasPorHora Decimal? @map("cajas_por_hora") @db.Decimal(8, 2)
  pesoNetoKg   Decimal? @map("peso_neto_kg") @db.Decimal(8, 3)

  activo Boolean @default(true)

  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  remisiones     Remision[]
  bloques        BloqueProgramacion[]
  averias        RegistroAveria[]
  /// Ítem de inventario del PT (opción A: el PT se enlaza, no se duplica).
  itemInventario ItemInventario?
  /// Versiones de su receta (la vigente es la de número más alto).
  recetas        Receta[]

  @@index([activo])
  @@map("producto")
}

model Turno {
  id     String  @id @default(uuid())
  codigo String  @unique // T1, T2, T3
  nombre String
  activo Boolean @default(true)

  horarios              TurnoHorario[]
  remisiones            Remision[]
  bloques               BloqueProgramacion[]
  asistencias           AsistenciaTurno[]
  asignaciones          AsignacionLinea[]
  averias               ReporteAveria[]
  movimientosInventario MovimientoInventario[]
  entradasMercancia     EntradaMercancia[]
  listasDistribucion    ListaDistribucion[]
  resumenes             ResumenTurno[]
  esperadasGrupos       GrupoEsperadasTurno[]
  ajustesEsperadas      AjusteEsperadas[]

  @@map("turno")
}

/// Los horarios son configuración y no valores fijos en código.
/// Decisión del 2026-09-18: se usan los del DPP de PepsiCo todos los días:
///   T1 06:00-13:30 · T2 14:00-21:30 · T3 22:00-05:30
model TurnoHorario {
  id        String    @id @default(uuid())
  turnoId   String    @map("turno_id")
  turno     Turno     @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  diaSemana DiaSemana @map("dia_semana")

  horaInicio String @map("hora_inicio") // "HH:mm"
  horaFin    String @map("hora_fin") // "HH:mm"

  /// true cuando horaFin < horaInicio (T3)
  cruzaMedianoche Boolean @default(false) @map("cruza_medianoche")

  vigenteDesde DateTime  @map("vigente_desde") @db.Date
  vigenteHasta DateTime? @map("vigente_hasta") @db.Date

  @@unique([turnoId, diaSemana, vigenteDesde])
  @@map("turno_horario")
}

// ============================================================
// REMISIONES
// ============================================================

/// Documento formal de entrega de Producto Terminado ("llevo o recibo").
/// Una remisión corresponde a UN SOLO producto (SKU).
/// El consecutivo reinicia cada año → clave única (anio, numero).
///
/// Nunca se elimina físicamente: es un documento firmado.
/// Un rechazo se corrige mediante rectificación (nueva versión),
/// conservando el mismo consecutivo.
model Remision {
  id      String @id @default(uuid())
  anio    Int
  numero  Int
  version Int    @default(1)

  // --- Temporalidad ---
  /// Día productivo al que pertenece. Corte 6:00 a 6:00.
  /// fechaOperativa = fecha(fechaHoraRegistro − 6h) en zona America/Bogota.
  /// TODAS las agregaciones y reportes se agrupan por este campo.
  fechaOperativa    DateTime @map("fecha_operativa") @db.Date
  fechaHoraRegistro DateTime @map("fecha_hora_registro") @db.Timestamptz(3)

  turnoId String @map("turno_id")
  turno   Turno  @relation(fields: [turnoId], references: [id])

  // --- Contexto ---
  grupoId String @map("grupo_id")
  grupo   Grupo  @relation(fields: [grupoId], references: [id])

  lugarId String @map("lugar_id")
  lugar   Lugar  @relation(fields: [lugarId], references: [id])

  // --- Producto (uno solo) ---
  productoId String   @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id])

  /// Copia congelada al momento de crear. La remisión es un documento
  /// firmado: si el catálogo cambia después, el documento debe seguir
  /// mostrando lo que decía cuando se firmó.
  codigoSnapshot      String @map("codigo_snapshot")
  descripcionSnapshot String @map("descripcion_snapshot")

  fechaVencimiento DateTime @map("fecha_vencimiento") @db.Date
  cantidadCajas    Int      @map("cantidad_cajas")
  cantidadUnidades Int      @map("cantidad_unidades")

  /// Reemplaza el texto libre del Excel ("2 ESTIBAS+ 21 CAJAS").
  /// El sistema compone el texto para mostrar; no lo almacena.
  estibasCompletas Int @default(0) @map("estibas_completas")
  cajasSueltas     Int @default(0) @map("cajas_sueltas")

  /// Notas humanas reales. Los números de estiba van en RemisionEstiba.
  observaciones String?

  /// Pedido de emergencia fuera del DPP de PepsiCo (área, 2026-09-18):
  /// no cuenta para el MFR ni para el tope de lo programado. Exige motivo.
  extraoficial       Boolean @default(false)
  motivoExtraoficial String? @map("motivo_extraoficial")

  // --- Flujo ---
  estado EstadoRemision @default(BORRADOR)

  motivoUltimoRechazo String? @map("motivo_ultimo_rechazo")

  creadaPorId String  @map("creada_por_id")
  creadaPor   Usuario @relation("RemisionCreadaPor", fields: [creadaPorId], references: [id])

  entregadaPorId String?   @map("entregada_por_id")
  entregadaPor   Usuario?  @relation("RemisionEntregadaPor", fields: [entregadaPorId], references: [id])
  fechaEntrega   DateTime? @map("fecha_entrega") @db.Timestamptz(3)

  /// El OPA es personal de PepsiCo: NO es usuario del sistema.
  /// Su participación se registra como dato, no como cuenta.
  opaNombre       String?   @map("opa_nombre")
  opaCargo        String?   @map("opa_cargo")
  fechaAprobacion DateTime? @map("fecha_aprobacion") @db.Timestamptz(3)

  /// Validación = conciliación administrativa interna (cuaderno virtual).
  /// Es un evento DISTINTO de la aprobación del OPA.
  validadaPorId   String?   @map("validada_por_id")
  validadaPor     Usuario?  @relation("RemisionValidadaPor", fields: [validadaPorId], references: [id])
  fechaValidacion DateTime? @map("fecha_validacion") @db.Timestamptz(3)
  /// Contacto de PepsiCo con quien se concilió. Se guarda como dato
  /// y no como entidad, para no acoplar el sistema a una persona.
  conciliadoCon   String?   @map("conciliado_con")

  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  estibas   RemisionEstiba[]
  versiones RemisionVersion[]
  firmas    FirmaRemision[]
  /// PI e insumos que descontó al aprobarse (cajas × receta vigente).
  consumos  MovimientoInventario[]

  @@unique([anio, numero])
  @@index([fechaOperativa, turnoId])
  @@index([estado])
  @@index([productoId, fechaOperativa])
  @@index([grupoId, fechaOperativa])
  @@map("remision")
}

/// Números de estiba física. Reemplaza el texto "EST: 31,32,33..."
/// que hoy vive en el campo de observaciones del Excel.
/// Base de la trazabilidad de ubicación para el módulo de inventario.
model RemisionEstiba {
  id         String   @id @default(uuid())
  remisionId String   @map("remision_id")
  remision   Remision @relation(fields: [remisionId], references: [id], onDelete: Cascade)

  numeroEstiba Int @map("numero_estiba")

  @@unique([remisionId, numeroEstiba])
  @@index([numeroEstiba])
  @@map("remision_estiba")
}

/// Historial del documento. Cada rectificación agrega un registro
/// con el estado anterior completo y el motivo del rechazo.
model RemisionVersion {
  id         String   @id @default(uuid())
  remisionId String   @map("remision_id")
  remision   Remision @relation(fields: [remisionId], references: [id], onDelete: Cascade)

  version       Int
  motivoRechazo String? @map("motivo_rechazo")

  /// Snapshot completo de la versión previa.
  datosAnteriores Json @map("datos_anteriores")

  rectificadaPorId String  @map("rectificada_por_id")
  rectificadaPor   Usuario @relation(fields: [rectificadaPorId], references: [id])

  fechaRectificacion DateTime @default(now()) @map("fecha_rectificacion") @db.Timestamptz(3)

  @@unique([remisionId, version])
  @@map("remision_version")
}

// ============================================================
// AUDITORÍA TRANSVERSAL
// ============================================================

/// Registro de toda acción sobre entidades sensibles.
/// Requisito de la sección 13 del documento maestro: la trazabilidad
/// forma parte del diseño inicial, no se agrega al final.
model Auditoria {
  id String @id @default(uuid())

  entidad   String // "remision", "producto", "turno_horario"
  entidadId String          @map("entidad_id")
  accion    AccionAuditoria

  valorAnterior Json? @map("valor_anterior")
  valorNuevo    Json? @map("valor_nuevo")

  /// Obligatorio en cambios sensibles (rectificación, edición de estándares).
  motivo String?

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  ip       String?
  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@index([entidad, entidadId])
  @@index([usuarioId, creadoEn])
  @@map("auditoria")
}

// ============================================================
// CONSECUTIVO
// ============================================================

/// Control del consecutivo anual de remisiones.
/// Se usa con bloqueo de fila (SELECT ... FOR UPDATE) dentro de la
/// transacción de creación, para evitar números duplicados cuando dos
/// coordinadores crean remisiones al mismo tiempo.
model Consecutivo {
  id     String @id @default(uuid())
  tipo   String // "REMISION"
  anio   Int
  ultimo Int    @default(0)

  @@unique([tipo, anio])
  @@map("consecutivo")
}

// ============================================================
// MFR — Manufacturing Fill Rate
// ============================================================

/// Línea de producción: activo físico con identidad estable (confirmado
/// por el DPP de PepsiCo, 2026-09-18). Tipo de máquina y capacidad
/// nominal en kg/h según el schedule; `orden` es el de las páginas del DPP.
model LineaProduccion {
  id              String    @id @default(uuid())
  codigo          String    @unique // L1, MANUAL-1, REEMPAQUES...
  nombre          String // como lo escribe PepsiCo: "MANUAL 1"
  tipo            TipoLinea @default(MANUAL)
  capacidadKgHora Decimal?  @map("capacidad_kg_hora") @db.Decimal(8, 2)
  orden           Int       @default(0)
  activo          Boolean   @default(true)

  bloques      BloqueProgramacion[]
  asignaciones AsignacionLinea[]

  @@map("linea_produccion")
}

/// Bloque del DPP de PepsiCo: en una línea, de una hora a otra, se corre
/// un producto a un ritmo de cajas/hora y una eficiencia esperada. Es a la vez la meta
/// (T = Mx × E) y la configuración de la línea. Se congela al cerrar el
/// turno (cerrado_en). El turno se deriva de la hora de inicio.
model BloqueProgramacion {
  id String @id @default(uuid())

  fechaOperativa DateTime        @map("fecha_operativa") @db.Date
  lineaId        String          @map("linea_id")
  linea          LineaProduccion @relation(fields: [lineaId], references: [id])
  turnoId        String          @map("turno_id")
  turno          Turno           @relation(fields: [turnoId], references: [id])
  productoId     String          @map("producto_id")
  producto       Producto        @relation(fields: [productoId], references: [id])

  horaInicio String @map("hora_inicio") // "HH:mm"
  horaFin    String @map("hora_fin")

  cajasPorHora         Decimal      @map("cajas_por_hora") @db.Decimal(8, 2)
  eficienciaPorcentaje Decimal      @map("eficiencia_porcentaje") @db.Decimal(5, 2)
  loop                 String?
  personasAsignadas    Int?         @map("personas_asignadas")
  origen               OrigenBloque @default(MANUAL)

  creadoPorId   String   @map("creado_por_id")
  creadoPor     Usuario  @relation("BloqueCreadoPor", fields: [creadoPorId], references: [id])
  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(3)

  cerradoEn    DateTime? @map("cerrado_en") @db.Timestamptz(3)
  cerradoPorId String?   @map("cerrado_por_id")
  cerradoPor   Usuario?  @relation("BloqueCerradoPor", fields: [cerradoPorId], references: [id])

  @@index([fechaOperativa])
  @@index([fechaOperativa, lineaId])
  @@map("bloque_programacion")
}

/// Personas que llegaron de un grupo a un turno (área, 2026-09-21).
/// Se compara con `grupo.personas_esperadas` para saber si la
/// productividad del turno queda "a fin" o afectada.
model AsistenciaTurno {
  id String @id @default(uuid())

  fechaOperativa DateTime @map("fecha_operativa") @db.Date
  turnoId        String   @map("turno_id")
  turno          Turno    @relation(fields: [turnoId], references: [id])
  grupoId        String   @map("grupo_id")
  grupo          Grupo    @relation(fields: [grupoId], references: [id])

  personasLlegaron Int     @map("personas_llegaron")
  observacion      String?

  registradaPorId String   @map("registrada_por_id")
  registradaPor   Usuario  @relation("AsistenciaRegistradaPor", fields: [registradaPorId], references: [id])
  fechaRegistro   DateTime @default(now()) @map("fecha_registro") @db.Timestamptz(3)

  @@unique([fechaOperativa, turnoId, grupoId])
  @@index([fechaOperativa])
  @@map("asistencia_turno")
}

/// Qué grupo trabaja en qué línea, con cuántas personas, por día y turno.
/// Un grupo puede repartirse entre líneas; una línea puede tener varios grupos.
model AsignacionLinea {
  id String @id @default(uuid())

  fechaOperativa DateTime        @map("fecha_operativa") @db.Date
  turnoId        String          @map("turno_id")
  turno          Turno           @relation(fields: [turnoId], references: [id])
  lineaId        String          @map("linea_id")
  linea          LineaProduccion @relation(fields: [lineaId], references: [id])
  grupoId        String          @map("grupo_id")
  grupo          Grupo           @relation(fields: [grupoId], references: [id])

  personas Int

  registradaPorId String   @map("registrada_por_id")
  registradaPor   Usuario  @relation("AsignacionRegistradaPor", fields: [registradaPorId], references: [id])
  fechaRegistro   DateTime @default(now()) @map("fecha_registro") @db.Timestamptz(3)

  @@unique([fechaOperativa, turnoId, lineaId, grupoId])
  @@index([fechaOperativa])
  @@map("asignacion_linea")
}

// ============================================================
// AVERÍAS
// ============================================================

/// Causal de avería: lista generalizada del formulario del área
/// (2026-09-28). Administrable desde el panel; no se elimina, se
/// desactiva. `orden` es la posición en la lista desplegable.
model CausalAveria {
  id     String  @id @default(uuid())
  codigo String  @unique
  nombre String
  orden  Int     @default(0)
  activo Boolean @default(true)

  registros RegistroAveria[]

  @@map("causal_averia")
}

enum EstadoReporteAveria {
  REGISTRADO
  ANULADO
}

enum UnidadMedidaAveria {
  UNIDAD
  DOCENA
  SIX
  BOLSA
}

enum TipoEvidenciaAveria {
  UNIDAD
  LOTE_FECHA
  CONJUNTO
}

/// Encabezado del reporte de averías. Fecha, hora y turno los pone el
/// servidor; quién reporta sale del token. No se elimina: se anula con
/// motivo (solo el administrador).
model ReporteAveria {
  id String @id @default(uuid())

  fechaHoraRegistro DateTime @map("fecha_hora_registro") @db.Timestamptz(3)
  fechaOperativa    DateTime @map("fecha_operativa") @db.Date
  turnoId           String   @map("turno_id")
  turno             Turno    @relation(fields: [turnoId], references: [id])
  grupoId           String   @map("grupo_id")
  grupo             Grupo    @relation(fields: [grupoId], references: [id])

  reportadoPorId     String  @map("reportado_por_id")
  reportadoPor       Usuario @relation("AveriaReportadaPor", fields: [reportadoPorId], references: [id])
  /// Copia del nombre al reportar.
  reportadoPorNombre String  @map("reportado_por_nombre")

  estado          EstadoReporteAveria @default(REGISTRADO)
  motivoAnulacion String?             @map("motivo_anulacion")
  anuladoPorId    String?             @map("anulado_por_id")
  anuladoPor      Usuario?            @relation("AveriaAnuladaPor", fields: [anuladoPorId], references: [id])
  fechaAnulacion  DateTime?           @map("fecha_anulacion") @db.Timestamptz(3)

  registros RegistroAveria[]

  @@index([fechaOperativa])
  @@map("reporte_averia")
}

/// Una fila de "Agregar avería". Solo PT por ahora; PI e insumos llegan
/// con Inventario. Guarda copia congelada del producto. Sin línea (área,
/// 2026-09-28: las cajas averiadas a veces llegan sin saber de dónde vienen).
model RegistroAveria {
  id        String        @id @default(uuid())
  reporteId String        @map("reporte_id")
  reporte   ReporteAveria @relation(fields: [reporteId], references: [id])
  orden     Int

  productoId          String   @map("producto_id")
  producto            Producto @relation(fields: [productoId], references: [id])
  productoCodigo      String   @map("producto_codigo")
  productoDescripcion String   @map("producto_descripcion")

  fechaVencimiento DateTime           @map("fecha_vencimiento") @db.Date
  lote             String
  causalId         String             @map("causal_id")
  causal           CausalAveria       @relation(fields: [causalId], references: [id])
  cantidad         Int
  unidadMedida     UnidadMedidaAveria @map("unidad_medida")

  evidencias EvidenciaAveria[]

  @@index([reporteId])
  @@map("registro_averia")
}

/// Foto de evidencia: la imagen vive en el almacén; aquí solo la ruta.
model EvidenciaAveria {
  id         String              @id @default(uuid())
  registroId String              @map("registro_id")
  registro   RegistroAveria      @relation(fields: [registroId], references: [id])
  tipo       TipoEvidenciaAveria
  ruta       String

  @@unique([registroId, tipo])
  @@map("evidencia_averia")
}

// ============================================================
// INVENTARIO
// ============================================================

enum TipoItemInventario {
  INSUMO
  PI
  PT
}

enum TipoMovimientoInventario {
  ENTRADA
  SALIDA
  AJUSTE
}

/// Medidas y presentaciones (UNIDAD, METRO, ROLLO…). Catálogo
/// administrable: es la lista desplegable (usuario, 2026-09-29).
model UnidadMedida {
  id     String  @id @default(uuid())
  codigo String  @unique
  nombre String
  activo Boolean @default(true)

  pis                Pi[]     @relation("PiUnidadBase")
  insumos            Insumo[] @relation("InsumoUnidadBase")
  pisPresentacion    Pi[]     @relation("PiPresentacion")
  insumosPresentacion Insumo[] @relation("InsumoPresentacion")

  @@map("unidad_medida")
}

/// PI: producto intermedio, lo que llega de PepsiCo para reempaque.
/// La existencia se lleva en su medida (`unidad_base`, con decimales);
/// `presentacion` + `contenido_presentacion` dicen cómo viene (ROLLO de
/// 50 METRO). Escalones hacia arriba: estiba → caja → presentación.
model Pi {
  id                    String        @id @default(uuid())
  codigo                String        @unique
  descripcion           String
  unidadBaseId          String        @map("unidad_base_id")
  unidadBase            UnidadMedida  @relation("PiUnidadBase", fields: [unidadBaseId], references: [id])
  presentacionId        String?       @map("presentacion_id")
  presentacion          UnidadMedida? @relation("PiPresentacion", fields: [presentacionId], references: [id], onDelete: Restrict)
  contenidoPresentacion Decimal?      @map("contenido_presentacion") @db.Decimal(14, 3)
  unidadesPorCaja       Int?          @map("unidades_por_caja")
  cajasPorEstiba        Int?          @map("cajas_por_estiba")
  activo                Boolean       @default(true)

  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  itemInventario ItemInventario?

  @@map("pi")
}

/// Insumo: cajas, cintas, bolsas… lo que se consume para armar el PT.
/// Misma forma que el PI; tabla propia porque son cosas distintas
/// (usuario, 2026-09-29: "una tabla por cada tipo").
model Insumo {
  id                    String        @id @default(uuid())
  codigo                String        @unique
  descripcion           String
  unidadBaseId          String        @map("unidad_base_id")
  unidadBase            UnidadMedida  @relation("InsumoUnidadBase", fields: [unidadBaseId], references: [id])
  presentacionId        String?       @map("presentacion_id")
  presentacion          UnidadMedida? @relation("InsumoPresentacion", fields: [presentacionId], references: [id], onDelete: Restrict)
  contenidoPresentacion Decimal?      @map("contenido_presentacion") @db.Decimal(14, 3)
  unidadesPorCaja       Int?          @map("unidades_por_caja")
  cajasPorEstiba        Int?          @map("cajas_por_estiba")
  activo                Boolean       @default(true)

  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  itemInventario ItemInventario?

  @@map("insumo")
}

/// Existencia de UN PT, PI o insumo: apunta exactamente a uno de los tres
/// (restricción CHECK en la migración). Código, descripción, unidad y
/// "activo" se leen del catálogo correspondiente; aquí solo va la
/// existencia, en la medida del ítem con hasta 3 decimales (el PT, en
/// cajas enteras). Es la fila que se bloquea para que dos movimientos
/// simultáneos no partan de la misma existencia.
model ItemInventario {
  id         String             @id @default(uuid())
  tipo       TipoItemInventario
  productoId String?            @unique @map("producto_id")
  producto   Producto?          @relation(fields: [productoId], references: [id])
  piId       String?            @unique @map("pi_id")
  pi         Pi?                @relation(fields: [piId], references: [id])
  insumoId   String?            @unique @map("insumo_id")
  insumo     Insumo?            @relation(fields: [insumoId], references: [id])
  existencia Decimal            @default(0) @db.Decimal(14, 3)

  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  movimientos         MovimientoInventario[]
  /// Recetas de PT en las que este PI o insumo es componente.
  componentesDeReceta RecetaComponente[]
  lineasDeCierre      CierreInventarioLinea[]

  @@index([tipo])
  @@map("item_inventario")
}

/// Receta (lista de materiales) de un PT. VERSIONADA (usuario,
/// 2026-09-29): cada guardado crea una fila nueva; nunca se edita encima.
/// La vigente es la de `version` más alta. Así el consumo teórico de una
/// remisión pasada se calcula con la receta que regía entonces.
model Receta {
  id              String   @id @default(uuid())
  productoId      String   @map("producto_id")
  producto        Producto @relation(fields: [productoId], references: [id])
  version         Int
  vigenteDesde    DateTime @map("vigente_desde") @db.Timestamptz(3)
  creadaPorId     String   @map("creada_por_id")
  creadaPor       Usuario  @relation(fields: [creadaPorId], references: [id])
  /// Copia del nombre al guardar.
  creadaPorNombre String   @map("creada_por_nombre")

  componentes RecetaComponente[]

  @@unique([productoId, version])
  @@map("receta")
}

/// Un PI o insumo de la receta: `cantidad` que gasta UNA caja de PT, en
/// la medida del componente, con hasta 3 decimales. Ej.: 12 UNIDAD; 1,8 METRO.
model RecetaComponente {
  id       String         @id @default(uuid())
  recetaId String         @map("receta_id")
  receta   Receta         @relation(fields: [recetaId], references: [id])
  itemId   String         @map("item_id")
  item     ItemInventario @relation(fields: [itemId], references: [id])
  cantidad Decimal        @db.Decimal(14, 3)

  @@unique([recetaId, itemId])
  @@map("receta_componente")
}

/// Kardex: cada entrada, salida o ajuste con el saldo que dejó. Nunca se
/// borra; un error se corrige con un AJUSTE con motivo. Fecha, hora y
/// turno los pone el servidor. Sin lote (usuario, 2026-09-29).
model MovimientoInventario {
  id     String                   @id @default(uuid())
  itemId String                   @map("item_id")
  item   ItemInventario           @relation(fields: [itemId], references: [id])
  tipo   TipoMovimientoInventario

  /// Con signo, en la unidad base: lo que sumó o restó.
  cantidad Decimal @db.Decimal(14, 3)
  /// Existencia después del movimiento.
  saldo    Decimal @db.Decimal(14, 3)

  fechaHoraRegistro DateTime @map("fecha_hora_registro") @db.Timestamptz(3)
  fechaOperativa    DateTime @map("fecha_operativa") @db.Date
  turnoId           String   @map("turno_id")
  turno             Turno    @relation(fields: [turnoId], references: [id])
  usuarioId         String   @map("usuario_id")
  usuario           Usuario  @relation(fields: [usuarioId], references: [id])
  /// Copia del nombre al registrar.
  usuarioNombre     String   @map("usuario_nombre")

  referencia  String?
  observacion String?
  motivo      String?
  /// Lo que se digitó si fue un conteo mixto: "10 ROLLO (1 ROLLO = 50 METRO)".
  /// Copia: si luego cambia la equivalencia, el movimiento sigue diciendo con cuál se calculó.
  conteoTexto String? @map("conteo_texto")

  /// Entrada de mercancía a la que pertenece (si llegó en un documento).
  entradaId String?           @map("entrada_id")
  entrada   EntradaMercancia? @relation(fields: [entradaId], references: [id])

  /// Remisión cuya aprobación descontó este consumo (receta del PT).
  remisionId String?   @map("remision_id")
  remision   Remision? @relation(fields: [remisionId], references: [id], onDelete: Restrict)

  /// Cierre del día cuyo conteo físico originó este ajuste (merma o sobrante).
  cierreId String?            @map("cierre_id")
  cierre   CierreInventario? @relation(fields: [cierreId], references: [id], onDelete: Restrict)

  @@index([itemId, fechaHoraRegistro])
  @@index([fechaOperativa])
  @@index([entradaId])
  @@index([remisionId])
  @@index([cierreId])
  @@map("movimiento_inventario")
}

/// Lo que llega a la planta en un mismo documento (remisión de PepsiCo,
/// guía…). Las líneas son los movimientos ENTRADA enlazados: no se
/// duplican. Fecha, hora, turno y quién recibe los pone el servidor.
model EntradaMercancia {
  id          String  @id @default(uuid())
  documento   String
  remitente   String?
  observacion String?

  fechaHoraRegistro DateTime @map("fecha_hora_registro") @db.Timestamptz(3)
  fechaOperativa    DateTime @map("fecha_operativa") @db.Date
  turnoId           String   @map("turno_id")
  turno             Turno    @relation(fields: [turnoId], references: [id])
  usuarioId         String   @map("usuario_id")
  usuario           Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioNombre     String   @map("usuario_nombre")

  movimientos MovimientoInventario[]

  @@index([fechaOperativa])
  @@map("entrada_mercancia")
}

/// Lista de distribución de correo (usuario, 2026-10-03): "Jefes",
/// "PepsiCo", "Turno T2"… La mantiene el administrador. Una lista de un
/// turno va en el envío automático cuando ese turno es el siguiente; una
/// general va en todos si `incluir_en_cierres`.
model ListaDistribucion {
  id               String   @id @default(uuid())
  nombre           String
  turnoId          String?  @map("turno_id")
  turno            Turno?   @relation(fields: [turnoId], references: [id])
  incluirEnCierres Boolean  @default(false) @map("incluir_en_cierres")
  /// Qué recibe al cerrar el turno: REMISIONES (PepsiCo…), RESUMEN (jefes,
  /// coordinadores) o AMBOS (usuario, 2026-10-03).
  recibe           String   @default("REMISIONES")
  correos          String[]
  activo           Boolean  @default(true)

  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  @@map("lista_distribucion")
}

/// Cada envío de remisiones por correo: a quién, qué remisiones y si el
/// servidor lo aceptó (ENVIADO) o no (FALLIDO, con el error). Trazabilidad.
model EnvioCorreo {
  id             String   @id @default(uuid())
  origen         String // MANUAL | CIERRE_TURNO
  fechaHora      DateTime @map("fecha_hora") @db.Timestamptz(3)
  fechaOperativa DateTime @map("fecha_operativa") @db.Date
  turnoId        String?  @map("turno_id")
  destinatarios  String[]
  remisionIds    String[] @map("remision_ids")
  asunto         String
  estado         String // ENVIADO | FALLIDO
  error          String?
  usuarioId      String   @map("usuario_id")
  usuario        Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioNombre  String   @map("usuario_nombre")

  @@index([fechaOperativa])
  @@map("envio_correo")
}

/// Firma electrónica de una casilla del formato de la remisión (usuario,
/// 2026-10-03). Una por casilla y versión; nunca se borra ni se edita.
/// `huella` = SHA-256 del contenido firmado; nombre, documento, rol y
/// declaración son copias congeladas.
model FirmaRemision {
  id               String   @id @default(uuid())
  remisionId       String   @map("remision_id")
  remision         Remision @relation(fields: [remisionId], references: [id])
  version          Int
  tipo             String // INLOTRANS | VERIFICADOR | RECIBE | VALIDACION
  usuarioId        String   @map("usuario_id")
  usuario          Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioNombre    String   @map("usuario_nombre")
  usuarioDocumento String   @map("usuario_documento")
  usuarioRol       String   @map("usuario_rol")
  declaracion      String
  huella           String
  /// PNG del trazo como data URL.
  trazo            String
  dispositivo      String?
  ip               String?
  fechaHora        DateTime @map("fecha_hora") @db.Timestamptz(3)

  @@unique([remisionId, version, tipo])
  @@index([remisionId])
  @@map("firma_remision")
}

/// Resumen del turno (RT) o del día (RD) que se toma al cerrar el turno
/// (usuario, 2026-10-03). Es una FOTO: `datos` se guarda tal cual y no se
/// edita; el PDF siempre muestra lo mismo. Consecutivo propio por tipo y
/// año (tabla `consecutivo`, tipos RESUMEN_TURNO / RESUMEN_DIA).
model ResumenTurno {
  id               String   @id @default(uuid())
  tipo             String // TURNO | DIA
  anio             Int
  numero           Int
  fechaOperativa   DateTime @map("fecha_operativa") @db.Date
  turnoId          String?  @map("turno_id")
  turno            Turno?   @relation(fields: [turnoId], references: [id])
  formatoCodigo    String?  @map("formato_codigo")
  formatoVersion   String?  @map("formato_version")
  formatoVigencia  String?  @map("formato_vigencia")
  datos            Json
  cerradoPorId     String   @map("cerrado_por_id")
  cerradoPor       Usuario  @relation(fields: [cerradoPorId], references: [id])
  cerradoPorNombre String   @map("cerrado_por_nombre")
  fechaHora        DateTime @map("fecha_hora") @db.Timestamptz(3)

  @@unique([tipo, anio, numero])
  @@index([fechaOperativa])
  @@map("resumen_turno")
}

/// Cierre del día operativo (usuario, 2026-10-01): conteo físico de los
/// materiales de las recetas y su merma. Uno por día (`fecha_operativa`
/// única). Sus ajustes en el kardex llevan `cierre_id`.
model CierreInventario {
  id                String   @id @default(uuid())
  /// El día operativo que se cierra.
  fechaOperativa    DateTime @unique @map("fecha_operativa") @db.Date
  fechaHoraRegistro DateTime @map("fecha_hora_registro") @db.Timestamptz(3)
  usuarioId         String   @map("usuario_id")
  usuario           Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioNombre     String   @map("usuario_nombre")
  observacion       String?

  lineas      CierreInventarioLinea[]
  movimientos MovimientoInventario[]

  @@map("cierre_inventario")
}

/// Un material contado: lo que decía el sistema, lo en tránsito, lo
/// esperado, lo contado y la merma (esperado − contado; negativa = sobrante).
/// Es la foto del momento: se guarda tal cual para la trazabilidad.
model CierreInventarioLinea {
  id                String           @id @default(uuid())
  cierreId          String           @map("cierre_id")
  cierre            CierreInventario @relation(fields: [cierreId], references: [id])
  itemId            String           @map("item_id")
  item              ItemInventario   @relation(fields: [itemId], references: [id])
  codigo            String
  descripcion       String
  unidad            String
  existenciaSistema Decimal          @map("existencia_sistema") @db.Decimal(14, 3)
  enTransito        Decimal          @map("en_transito") @db.Decimal(14, 3)
  esperado          Decimal          @db.Decimal(14, 3)
  contado           Decimal          @db.Decimal(14, 3)
  merma             Decimal          @db.Decimal(14, 3)
  consumoTeorico    Decimal          @map("consumo_teorico") @db.Decimal(14, 3)
  mermaPorcentaje   Decimal?         @map("merma_porcentaje") @db.Decimal(8, 1)
  conteoTexto       String?          @map("conteo_texto")

  @@unique([cierreId, itemId])
  @@map("cierre_inventario_linea")
}
