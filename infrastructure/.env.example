# Copiar a `infrastructure/.env` y completar. Lo lee docker compose.
# NUNCA subir el .env a Git.

# Persistencia: "postgres" (contenedor db) o "firestore" (Firebase)
PERSISTENCIA=postgres
# Solo si PERSISTENCIA=firestore (cuenta de servicio; ver backend/.env.example)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Base de datos (contenedor db)
POSTGRES_DB=mq
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Usuario de aplicación con permisos limitados (lo crea database/crear-usuario-app.sql)
MQ_APP_PASSWORD=

# API
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
ADMIN_INICIAL_DOCUMENTO=
ADMIN_INICIAL_NOMBRE=Administrador
ADMIN_INICIAL_PASSWORD=
# Origen permitido para CORS (URL desde la que se abre el frontend)
CORS_ORIGIN=http://localhost
# Sembrar catálogos en cada arranque (idempotente). "false" para desactivarlo.
MQ_SEED_AL_ARRANCAR=true

# Puerto en el host para la web
PUERTO_WEB=80
