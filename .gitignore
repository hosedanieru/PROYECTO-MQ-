node_modules/
dist/
# Estado incremental de TypeScript: es un artefacto de compilación, no
# código. Versionarlo hace que tras un pull TypeScript crea que ya
# compiló y deje dist vacío.
*.tsbuildinfo
.env
.env.*
!.env.example
!.env.test.example
!.env.firestore.test.example
coverage/
*.log
.DS_Store

# Reportes de importación (se generan al correr importar:tiempos)
backend/informes/
# Fotos de las averías (almacén en disco): son datos, no código
backend/evidencias/
# Correos guardados como .eml cuando no hay servidor SMTP configurado (pueden llevar remisiones)
backend/correos-salida/
# Scripts temporales del asistente
backend/*.tmp.mjs
